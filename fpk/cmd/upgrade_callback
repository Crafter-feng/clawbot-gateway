#!/bin/bash
# ============================================================
# ClawBot Gateway for fnOS - 升级后回调 (upgrade_callback)
# ============================================================
# 执行时机：升级安装完成后
# 用途：确保新版本二进制可执行，数据目录正确
# ============================================================

APP_BIN="${TRIM_APPDEST}/server/clawbot-gateway"

# ---- 确保新版本二进制有可执行权限 ----
if [ -f "${APP_BIN}" ]; then
    chmod 755 "${APP_BIN}"
else
    echo "ClawBot Gateway 二进制未找到: ${APP_BIN}" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

# ---- 确保数据目录存在 ----
mkdir -p "${TRIM_PKGVAR}"
chown -R "${TRIM_USERNAME:-clawbot}:${TRIM_GROUPNAME:-clawbot}" "${TRIM_PKGVAR}" 2>/dev/null || true

exit 0