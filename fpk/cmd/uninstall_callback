#!/bin/bash
# ============================================================
# ClawBot Gateway for fnOS - 卸载后清理 (uninstall_callback)
# ============================================================
# 执行时机：卸载完成后
# 用途：清理数据目录
# ============================================================

# 询问用户是否保留数据
# 如果 TRIM_REMOVE_DATA 为 true 则删除数据目录
if [ "${TRIM_REMOVE_DATA}" = "true" ]; then
    rm -rf "${TRIM_PKGVAR}" 2>/dev/null || true
fi

exit 0