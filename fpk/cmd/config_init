#!/bin/bash
# ============================================================
# ClawBot Gateway for fnOS - 配置变更前准备 (config_init)
# ============================================================
# 执行时机：配置变更前
# 用途：检查配置有效性
# ============================================================

# 验证端口号
PORT="${TRIM_SERVICE_PORT:-6798}"
if ! [[ "${PORT}" =~ ^[0-9]+$ ]] || [ "${PORT}" -lt 1 ] || [ "${PORT}" -gt 65535 ]; then
    echo "无效的端口号: ${PORT}" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

exit 0