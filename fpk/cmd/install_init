#!/bin/bash
# ============================================================
# ClawBot Gateway for fnOS - 安装前检查 (install_init)
# ============================================================
# 执行时机：fpk 解压前，安装向导展示前
# 用途：检查系统环境是否满足要求
# ============================================================

# 检查是否为 x86_64 架构
ARCH=$(uname -m)
if [ "${ARCH}" != "x86_64" ]; then
    echo "不支持的系统架构: ${ARCH}，仅支持 x86_64" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

exit 0