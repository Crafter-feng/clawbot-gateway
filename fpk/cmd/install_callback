#!/bin/bash
# ============================================================
# ClawBot Gateway for fnOS - 安装后初始化 (install_callback)
# ============================================================
# 执行时机：fpk 解压 + 安装向导填写完成之后
# 用途：初始化数据目录、设置登录密码
#
# 向导传入的环境变量：
#   wizard_port     - 用户配置的服务端口
#   wizard_password - 用户配置的登录密码（必填）
# ============================================================

DATA_DIR="${TRIM_PKGVAR}"
APP_BIN="${TRIM_APPDEST}/server/clawbot-gateway"
DB_PATH="${DATA_DIR}/clawbot.db"
CONFIG_DIR="${DATA_DIR}/config"

# ---- 确保二进制有可执行权限 ----
if [ -f "${APP_BIN}" ]; then
    chmod 755 "${APP_BIN}"
else
    echo "ClawBot Gateway 二进制未找到: ${APP_BIN}" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

# ---- 创建数据目录 ----
mkdir -p "${DATA_DIR}" "${CONFIG_DIR}"

# ---- 设置登录密码（通过 reset-password 子命令写入数据库）----
PASSWORD="${wizard_password}"
if [ -z "${PASSWORD}" ]; then
    echo "未提供登录密码" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

export CLAWBOT_DB_PATH="${DB_PATH}"
"${APP_BIN}" reset-password "${PASSWORD}" > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo "设置登录密码失败" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

# ---- 保存端口配置到 config（供 cmd/main 读取）----
cat > "${CONFIG_DIR}/wizard.json" << EOF
{
    "service_port": "${wizard_port:-6798}"
}
EOF

# ---- 设置目录权限 ----
chown -R "${TRIM_USERNAME:-clawbot}:${TRIM_GROUPNAME:-clawbot}" "${DATA_DIR}" 2>/dev/null || true

exit 0