# ============================================================
# ClawBot Gateway for fnOS - 应用清单
# ============================================================
# 此文件定义飞牛应用中心展示的元数据信息。
# platform 字段由 GitHub Actions 构建时自动替换为 x86 / arm。
# ============================================================

# 应用标识（全局唯一，用于飞牛内部索引）
appname               = clawbot-gateway

# 应用版本号
version = 0.0.3

# 应用中心显示名称
display_name          = ClawBot Gateway

# 应用描述（支持 HTML 标签，展示在应用中心详情页）
desc                  = 微信 iLink 消息网关，支持多后端适配、智能路由和虚拟 Bot 代理。<br><br><b>功能特性：</b><ul><li>微信多账号管理，扫码登录即可接入</li><li>智能消息路由：按规则分发到不同后端</li><li>后端适配器：OpenAI、Echo 调试等</li><li>虚拟 Bot 代理：提供标准 iLink 服务端 API</li><li>文件中转与通知通道</li><li>可视化 Web 管理面板 (PWA)</li></ul>

# 目标平台（x86 或 arm，由 CI 构建时自动设置）
platform = x86

# 应用来源标识
source                = thirdparty

# 维护者信息
maintainer            = Crafter-feng
maintainer_url        = https://github.com/Crafter-feng/clawbot-gateway

# 分发者信息
distributor           = Crafter-feng
distributor_url       = https://github.com/Crafter-feng/clawbot-gateway

# 最低支持的飞牛系统版本
os_min_version        = 0.9.0

# 桌面 UI 目录（相对于 app/ 目录）
desktop_uidir         = ui

# 点击应用图标时打开的桌面入口名称
desktop_applaunchname = clawbot-gateway.Application

# 应用服务监听端口（安装向导可修改）
service_port          = 6798

# 是否检查端口冲突
checkport             = true

